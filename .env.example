# Repply CRM — variaveis do site (Vite)
# Copie para .env e preencha. NUNCA commite o .env preenchido.

# --- Supabase (obrigatorias) ---
# Endereco do projeto, ex.: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Chave publica. Vai dentro do navegador, e publica por natureza.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Identificador do projeto, ex.: xxxxxxxx
VITE_SUPABASE_PROJECT_ID=

# --- Portao de assinatura (opcional) ---
# Liga o paywall. Ver src/lib/plano-gate.ts.
VITE_PAYWALL_ATIVO=

# --- Uso local apenas (NAO vai para o navegador) ---
# Usada so por scripts de manutencao em scripts/. Tratar como senha.
SUPABASE_SERVICE_ROLE_KEY=

# Os segredos das Edge Functions (NYLAS_*, UAZAPI_*, STRIPE_*, LOVABLE_API_KEY,
# GEMINI_API_KEY, GOOGLE_CLIENT_*, APP_URL) NAO ficam aqui: sao configurados no
# painel do Supabase. Ver README.md, secao "Variaveis de ambiente".
